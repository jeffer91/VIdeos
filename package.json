{
  "name": "videos-recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prestart": "node scripts/copy-ffmpeg.mjs",
    "start": "electron .",
    "start:web": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "build": "vite build",
    "audit": "node scripts/audit-workflow.mjs",
    "test": "npm run audit",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/copy-ffmpeg.mjs"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.3.0",
    "vite": "5.4.11"
  }
}
